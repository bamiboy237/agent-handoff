{
  "name": "agent-handoff",
  "version": "0.2.0",
  "description": "Hand off a coding agent task from your machine to a cloud sandbox, with the agent and provider of your choice.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-handoff": "dist/index.js"
  },
  "files": [
    "dist",
    "remote",
    "!remote/*.test.mjs",
    "skills",
    "bridges"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "node --test remote/watch.test.mjs",
    "preview:watch": "node scripts/watch-preview.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node --test scripts/site.test.mjs",
    "preview:site": "node scripts/site-preview.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@daytonaio/sdk": "0.225.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vercel/sandbox": "3.8.0",
    "e2b": "2.58.0",
    "jsonc-parser": "3.3.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
