{
  "name": "agent-handoff",
  "version": "0.2.0",
  "description": "Hand off a coding agent task from your machine to a cloud sandbox, with the agent and provider of your choice.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-handoff": "dist/index.js"
  },
  "files": [
    "dist",
    "remote",
    "skills",
    "bridges"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@daytonaio/sdk": "0.225.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vercel/sandbox": "3.8.0",
    "e2b": "2.58.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
